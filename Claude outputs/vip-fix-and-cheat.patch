Subject: [PATCH 2/2] Add F1 cheat: VIP comes to me now

Spawns the VIP guest right in front of the player, facing them (starts the VIP rule
if needed; night only), so the VIP model can be checked quickly in a build.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01NAWLTTQaFYRbXroQTVzipa
---
 Assets/_Script/Dev/DevCheatPanel.cs   |  3 +++
 Assets/_Script/MapRules/MapRuleVip.cs | 22 ++++++++++++++++++++++
 2 files changed, 25 insertions(+)

diff --git a/Assets/_Script/Dev/DevCheatPanel.cs b/Assets/_Script/Dev/DevCheatPanel.cs
index 9c5317c..bdad1bd 100644
--- a/Assets/_Script/Dev/DevCheatPanel.cs
+++ b/Assets/_Script/Dev/DevCheatPanel.cs
@@ -38,6 +38,7 @@ public sealed class DevCheatPanel : MonoBehaviour
         AudienceRoamOn, AudienceRoamOff, ToiletGhostsOn, ToiletGhostsOff,
         VipStart, VipFilmIn, VipServe, VipFail, HunterStart, HunterEnd, ForeignStart, ForeignAllIn, ForeignClear,
         ReviveSelf, // 28 Nov (Atiroj): added at the END so older numbers keep their meaning
+        VipToMe, // 28 Nov (Atiroj): the VIP appears right in front of me (to look at its model)
     }
 
     private static bool serverHandlerReady;
@@ -160,6 +161,7 @@ public sealed class DevCheatPanel : MonoBehaviour
             case Cheat.VipFilmIn: if (MapRuleVip.Instance != null) MapRuleVip.Instance.ServerDevFilmIn(); break;
             case Cheat.VipServe: if (MapRuleVip.Instance != null) MapRuleVip.Instance.ServerDevServe(); break;
             case Cheat.VipFail: if (MapRuleVip.Instance != null) MapRuleVip.Instance.ServerDevFail(); break;
+            case Cheat.VipToMe: if (MapRuleVip.Instance != null) MapRuleVip.Instance.ServerDevComeTo(player); break;
             case Cheat.HunterStart:
             case Cheat.HunterEnd:
                 MapRuleHunter hunter = FindAnyObjectByType<MapRuleHunter>();
@@ -413,6 +415,7 @@ public sealed class DevCheatPanel : MonoBehaviour
             Row(("Toilet ghosts: START", () => Do(Cheat.ToiletGhostsOn, "Toilet ghosts walk (forced)")),
                 ("Toilet ghosts: STOP", () => Do(Cheat.ToiletGhostsOff, "Toilet ghosts leave (unless toilets are dirty)")));
             GUILayout.Label("  Map Rule 3: VIP guest (clock stops)");
+            Button("VIP: come to me NOW", () => Do(Cheat.VipToMe, "VIP appears in front of you (night only)"));
             Row(("VIP arrives now", () => Do(Cheat.VipStart, "VIP arrives (front door)")),
                 ("VIP film is in", () => Do(Cheat.VipFilmIn, "VIP film put in the crank projector")));
             Row(("VIP served (skip)", () => Do(Cheat.VipServe, "VIP served: Map Rules 2 + 1 start")),
diff --git a/Assets/_Script/MapRules/MapRuleVip.cs b/Assets/_Script/MapRules/MapRuleVip.cs
index 213cb89..a8f66e7 100644
--- a/Assets/_Script/MapRules/MapRuleVip.cs
+++ b/Assets/_Script/MapRules/MapRuleVip.cs
@@ -197,6 +197,28 @@ public sealed class MapRuleVip : MapEventBase
         Arrive();
     }
 
+    /// <summary>
+    /// SERVER. 28 Nov (Atiroj): the VIP appears right in front of <paramref name="player"/>, facing them
+    /// (to test its model quickly). Starts the VIP rule if it is not running yet (night only, like
+    /// "VIP arrives now"). Does nothing while the VIP is already seated.
+    /// </summary>
+    public void ServerDevComeTo(GameObject player)
+    {
+        if (!IsServerSide || !NightRunning || player == null) return;
+        if (!Running) ServerDevStart();
+        if (vip == null || stage != Stage.Arrived) return;
+
+        Vector3 forward = player.transform.forward;
+        forward.y = 0f;
+        if (forward.sqrMagnitude < 0.01f) forward = Vector3.forward;
+        forward.Normalize();
+        Vector3 at = player.transform.position + forward * 2f;
+        if (UnityEngine.AI.NavMesh.SamplePosition(at, out UnityEngine.AI.NavMeshHit hit, 2f, UnityEngine.AI.NavMesh.AllAreas)) at = hit.position;
+
+        if (escort != null) DropEscort(); // stands still in front of you (press E on it to be followed again)
+        vip.ServerPlaceAt(at, Quaternion.LookRotation(-forward).eulerAngles.y);
+    }
+
     /// <summary>SERVER. The VIP film is in the crank projector.</summary>
     public void ServerDevFilmIn() { if (IsServerSide && Running) filmIn = true; }
 
-- 
