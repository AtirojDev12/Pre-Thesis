%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 642a6bab34dcbd842b5b2ec6dbc957e3, type: 3}
  m_Name: demo_map_01
  m_EditorClassIdentifier: Assembly-CSharp::MapGuide
  mapID: demo_map_01
  mapName: Cinema
  zonesForOnePlayer: 2
  extraZonesPerPlayer: 1
  maxZonesToFinish: 6
  mapPicture: {fileID: 0}
  howToWin: 'Night: 00:00 to 06:00. Exits are locked.

    Finish your zones. Each
    zone has a task board.

    06:00: exits open. 2 people per exit.

    Friend
    down? Hold E on them.

    Money = your tasks. Die = lose your items.'
  zones:
  - name: Ticket Zone
    picture: {fileID: 0}
    where: Front of the cinema.
    tasks: 'Sell the right ticket.

      Make food and drinks to order.'
    rules:
    - title: Tickets
      whatToDo: Human ticket for people, ghost ticket for ghosts.
      ifYouBreakIt: Lose sanity.
    - title: Ghost food
      whatToDo: Ghosts need Ghost Flavor in their food.
      ifYouBreakIt: Lose HP and sanity.
    - title: Missing flavor
      whatToDo: Lights cut out, Ghost Flavor vanishes. Follow the trail, bring it
        back.
      ifYouBreakIt: No ghost food.
    - title: The one who returns
      whatToDo: Signs on their spots. Lights off. Be quiet.
      ifYouBreakIt: It attacks.
    - title: Missing parts
      whatToDo: Find the ghost's lost part within 1 hour.
      ifYouBreakIt: Lose HP and sanity.
    allRulesOn: 1
    otherDangers: 
  - name: Screen Rooms
    picture: {fileID: 0}
    where: 'Theatre wing: normal room and GHOST room.'
    tasks: 'Ghost room: change film at 02:00 and 04:00.

      Ghost room: mop 3
      stains after 01:00.'
    rules:
    - title: No noise
      whatToDo: Walk slowly. Don't shout.
      ifYouBreakIt: Lose sanity.
    - title: Audience
      whatToDo: Don't look at the ghosts in the seats.
      ifYouBreakIt: Lose HP.
    - title: They stand up
      whatToDo: Freeze. When they sit, leave.
      ifYouBreakIt: They chase you.
    - title: Static screen
      whatToDo: Sit on the black shadow seat. Stay.
      ifYouBreakIt: A ghost roams till 06:00.
    allRulesOn: 0
    otherDangers: 
  - name: Toilets
    picture: {fileID: 0}
    where: Men's and women's toilets.
    tasks: 'After 03:00: mop 3 stains in each.'
    rules:
    - title: Cracked mirror
      whatToDo: Look at the crack.
      ifYouBreakIt: It shatters on you.
    - title: Crying stall
      whatToDo: Light off. Stand still.
      ifYouBreakIt: It chases you.
    - title: Smoke
      whatToDo: Knock on the stall. Light off.
      ifYouBreakIt: Lose HP. Tasks locked.
    - title: Feed it
      whatToDo: 'When clean: light off, box in, get out.'
      ifYouBreakIt: Ghosts swarm.
    allRulesOn: 0
    otherDangers: 
  generalTips: 'Tell your team which rules you saw.

    Keep your flashlight charged.

    Low
    sanity? Hold C or eat a snack.

    Carry a walkie. It works when you''re down.'
  mapRules:
  - title: '3 AM: VIP guest'
    whatToDo: Lead it to its seat. Gold film in. Crank fast.
    ifYouBreakIt: Everyone loses half sanity.
  - title: Lights out
    whatToDo: Stay out of the flashlight. Seen? Run.
    ifYouBreakIt: Caught = dead.
  - title: Hidden things
    whatToDo: Find them by the walls. Hit them (bat or mop).
    ifYouBreakIt: They get in and block work.
  guideVersion: 2
